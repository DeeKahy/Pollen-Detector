[Unit]
Description=Pollen sampler controller
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 -m pollen_device --config @DIR@/config.yaml
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
